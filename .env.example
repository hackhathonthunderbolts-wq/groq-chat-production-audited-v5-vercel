# Required
GROQ_API_KEY=your_groq_api_key_here

# Optional PostgreSQL persistence. Leave unset for local-only messaging demo state.
DATABASE_URL=postgresql://user:password@host:5432/database
# DATABASE_SSL=false
# DB_POOL_MAX=10
# API_RATE_LIMIT=60

# Optional: change the demo trigger word.
VITE_TRIGGER_WORD=/unlock-node
